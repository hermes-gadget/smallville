[Unit]
Description=Smallville Reverie simulation backend
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/hermes-agent/smallville/reverie/backend_server
ExecStart=/bin/bash -c 'cd /home/hermes-agent/smallville/reverie/backend_server && printf "base_the_ville_isabella_maria_klaus\npublic_sim\n" | /home/hermes-agent/smallville/.venv/bin/python reverie.py'
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
