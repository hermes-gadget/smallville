[Unit]
Description=Smallville Reverie simulation backend
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/hermes-agent/smallville/reverie/backend_server
# Embeddings reach the home AI box through the reverse SSH tunnel.
Environment=EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
# Headless mode: reverie.py <fork_sim> <sim_name> <run_steps>. Resumes the
# saved public_sim when it exists (no daily-plan regeneration); otherwise
# forks the base 3-agent town. After the run finishes the service exits and
# systemd restarts it, continuing from the saved state.
ExecStart=/bin/bash -c 'cd /home/hermes-agent/smallville/reverie/backend_server && if [ -d "../../environment/frontend_server/storage/public_sim" ]; then exec /home/hermes-agent/smallville/.venv/bin/python reverie.py public_sim public_sim 100000; else exec /home/hermes-agent/smallville/.venv/bin/python reverie.py base_the_ville_n9 public_sim 100000; fi'
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
